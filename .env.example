# Copy to .env and fill in. Never commit .env.

# Model used at build time for the three AI steps (receipt reading, account suggestion,
# exception explanations).
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. With a key the pipeline calls the Anthropic API through the Python SDK.
# Without it, it calls Claude Code in headless mode (`claude -p`) on the logged in
# Claude subscription, the same setup as the wFIAT project.
ANTHROPIC_API_KEY=

# Parallel LLM calls at build time
LLM_WORKERS=6
