# Copy to .env and fill in. Never commit .env.

# Model used at build time for the three AI steps (receipt reading, account suggestion,
# exception explanations).
ANTHROPIC_MODEL=claude-sonnet-5-5
# Receipt reading defaults to the small model (high volume). Override per step if needed.
ANTHROPIC_MODEL_EXTRACT=claude-haiku-5-5

# Optional. With a key the pipeline calls the Anthropic API through the Python SDK.
# Without it, it calls Claude Code in headless mode (`claude -p`) on the logged in
# Claude subscription.
ANTHROPIC_API_KEY=

# Parallel LLM calls at build time
LLM_WORKERS=6

# QuickBooks Online sandbox (only for `ctl qbo-auth` and `ctl qbo-post`, never in CI).
# Intuit rotates the refresh token: the commands write the new one back to .env.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox
